{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai-custom-solution",
      "destination": "/api/ai-custom-solution"
    },
    {
      "source": "/api/architecture-proposal",
      "destination": "/api/architecture-proposal"
    },
    {
      "source": "/api/architecture-qa",
      "destination": "/api/architecture-qa"
    },
    {
      "source": "/api/save-contact",
      "destination": "/api/save-contact"
    },
    {
      "source": "/api/save-proposal",
      "destination": "/api/save-proposal"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
