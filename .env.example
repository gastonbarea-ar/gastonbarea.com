VITE_CAL_COM_URL="https://cal.com/gastonbarea/30min"

# CORREO TRANSACCIONAL SALIENTE (RESEND.COM + CYBERPANEL 138.219.41.106)
# Dominio verificado: gastonbarea.com | Cuenta CyberPanel: notificaciones@gastonbarea.com
