# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Servidor / Serverless privado)
# Sin el prefijo VITE_ para que las credenciales permanezcan privadas en el backend y no se expongan en el bundle del navegador.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AGENDA TÉCNICA (CALENDLY / CAL.COM - URLs públicas seguras)
VITE_CALENDLY_URL="https://calendly.com/gastonbarea/30min"
VITE_CAL_COM_URL="https://cal.com/gastonbarea/30min"

# NOTIFICACIONES POR CORREO (SENDER API - https://www.sender.net)
# Token de API de Sender para el envío de propuestas, alertas de CRM y Portal Clientes
SENDER_API_KEY="your_sender_api_token"
NOTIFICATION_EMAIL="gastonbarea.com@gmail.com"
FROM_EMAIL="gaston@gastonbarea.com"
FROM_NAME="Gastón Barea"
WEBHOOK_SECRET="super-secret-webhook-token"
